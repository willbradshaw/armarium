filters:
  and:
    - 'file.ext == "md"'
    - 'type == link("reference/types/Clue")'
    - 'file.folder == "campaigns/" + this.file.folder.split("/")[1] + "/clues"'
properties:
  file.name:
    displayName: ID
  note.status:
    displayName: Status
  note.last_session:
    displayName: Last Session
  note.text:
    displayName: Text
views:
  - type: table
    name: Active
    filters: '[link("reference/statuses/Pending"), link("reference/statuses/Hinted")].contains(status)'
    order: [file.name, status, last_session, text]
    rowHeight: extra
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Closed
    filters: '[link("reference/statuses/Revealed"), link("reference/statuses/Abandoned"), link("reference/statuses/Dormant"), link("reference/statuses/Superseded")].contains(status)'
    order: [file.name, status, last_session, text]
    rowHeight: extra
    sort:
      - property: file.name
        direction: ASC
