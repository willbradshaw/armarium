filters:
  and:
    - 'file.ext == "md"'
    - 'type == link("reference/types/Content")'
    - 'file.inFolder("content") || file.inFolder("campaigns/" + this.file.folder.split("/")[1] + "/content")'
    - 'list(this.prepared_npcs).contains(file)'
    - 'subtype == "NPC"'
formulas:
  selection_order: 'list(this.prepared_npcs).map(if(value == file, index, -1)).filter(value >= 0)[0]'
properties:
  file.name:
    displayName: Name
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Important NPCs
    order: [file.name, summary]
    rowHeight: extra
    sort:
      - property: formula.selection_order
        direction: ASC
