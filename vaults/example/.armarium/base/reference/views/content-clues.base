filters:
  and:
    - 'file.ext == "md"'
    - 'type == link("reference/types/Clue")'
    - 'file.folder == "campaigns/" + file.folder.split("/")[1] + "/clues"'
    - 'this.file.inFolder("content") || (this.file.inFolder("campaigns") && file.folder.split("/")[1] == this.file.folder.split("/")[1])'
    - 'list(subjects).contains(this.file)'
    - '[link("reference/statuses/Pending"), link("reference/statuses/Hinted")].contains(status)'
formulas:
  text: 'note.text'
properties:
  file.name:
    displayName: ID
  formula.text:
    displayName: Text
views:
  - type: table
    name: Active Clues
    order: [file.name, formula.text]
    rowHeight: medium
    sort:
      - property: file.name
        direction: ASC
