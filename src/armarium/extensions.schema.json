{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Armarium extension declarations",
  "description": "The contents of a vault's reference/extensions.json and of an extension's extension.json: each extension's rules, the Content subtypes it declares and its installation state.",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "schema"
            ],
            "properties": {
              "type": {
                "$ref": "#/$defs/name"
              },
              "subtype": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "minLength": 1
              },
              "yaml_blocks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[^\\s`~]+$"
                }
              },
              "links": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "$ref": "#/$defs/name"
                    },
                    "subtypes": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/name"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "subtypes": {
          "type": "object",
          "properties": {
            "Content": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          },
          "additionalProperties": false
        },
        "installed": {
          "type": "boolean"
        },
        "armarium_version": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "description": "A type or subtype name: letters and digits, starting with a letter."
    }
  }
}
