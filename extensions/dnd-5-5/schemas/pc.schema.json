{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D&D 5.5 PC fields",
  "type": "object",
  "properties": {
    "frontmatter": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "pattern": "\\S"
        },
        "subclass": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "\\S"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    }
  }
}
